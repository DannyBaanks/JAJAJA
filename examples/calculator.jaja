# calculator.jaja - JAJAJA computes, Python only prints
# Input: "ADD 1 2" (space-separated, single digits 0-5)
# Same .jaja + different input = different output.
# Python does NOT compute 1+2=3. JAJAJA rules do.

# Addition
ADD 0 0::=~0
ADD 0 1::=~1
ADD 0 2::=~2
ADD 0 3::=~3
ADD 0 4::=~4
ADD 0 5::=~5
ADD 1 0::=~1
ADD 1 1::=~2
ADD 1 2::=~3
ADD 1 3::=~4
ADD 1 4::=~5
ADD 1 5::=~6
ADD 2 0::=~2
ADD 2 1::=~3
ADD 2 2::=~4
ADD 2 3::=~5
ADD 2 4::=~6
ADD 2 5::=~7
ADD 3 0::=~3
ADD 3 1::=~4
ADD 3 2::=~5
ADD 3 3::=~6
ADD 3 4::=~7
ADD 3 5::=~8
ADD 4 0::=~4
ADD 4 1::=~5
ADD 4 2::=~6
ADD 4 3::=~7
ADD 4 4::=~8
ADD 4 5::=~9
ADD 5 0::=~5
ADD 5 1::=~6
ADD 5 2::=~7
ADD 5 3::=~8
ADD 5 4::=~9
ADD 5 5::=~10

# Multiplication
MUL 0 0::=~0
MUL 0 1::=~0
MUL 0 2::=~0
MUL 0 3::=~0
MUL 1 0::=~0
MUL 1 1::=~1
MUL 1 2::=~2
MUL 1 3::=~3
MUL 2 0::=~0
MUL 2 1::=~2
MUL 2 2::=~4
MUL 2 3::=~6
MUL 3 0::=~0
MUL 3 1::=~3
MUL 3 2::=~6
MUL 3 3::=~9

::=
